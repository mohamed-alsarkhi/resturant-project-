@using resturant.Dtos
@model IEnumerable<UserDto>

@{
    ViewData["Title"] = "User Page";
    int count = 1;
}

<div class="text-center">
    <h1 class="display-4">Welcome User</h1>
</div>


<div class="container">
    <a asp-action="Create" class="btn btn-primary mb-3">Create New User</a>
    <table class="table table-hover table-bordered border-dark">
        <thead>
            <tr class="table-primary">
                
                <th>
                    #
                </th>
                <th>
                    ID
                </th>
                <th>
                    Name
                </th>

                <th>
                    Image
                </th>
            
                <th>View Roles</th>


                <th>View Files</th>
               
                <th>Actions</th>

            </tr>
        </thead>

        <tbody>

            @foreach (var name in Model)
            {

                <tr>
                    <td>
                        @count
                        @{
                            count++;
                        }
                    </td>

                    <td>
                        @name.Id
                    </td>
                    <td>
                        @name.Name
                    </td>

                    <td>
                        @if (!string.IsNullOrEmpty(name.ImageURL))
                        {
                            <img src="@name.ImageURL" width="50" height="50" class="rounded-circle" alt="User Image" />
                        }
                        else {
                            <span>No Image</span>
                        }
                    </td>
                    <td>
                        <a asp-controller="Users"
                           asp-action="ManageRoles"
                           asp-route-Id="@name.Id"
                           class="btn btn-info">
                            View Roles
                        </a>
                    </td>

                    <td>
                        <a asp-controller="Users"
                           asp-action="ManageFiles"
                           asp-route-UserId="@name.Id"
                           class="btn btn-primary">
                            View Files
                        </a>
                    </td>

                    <td>
                        <a asp-action="Edit" asp-route-id="@name.Id" class="btn btn-warning">Edit</a>
                        <form asp-action="DeleteConfirmed" asp-route-id="@name.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>

                    </td>

                </tr>
            }


        </tbody>

    </table>


</div>