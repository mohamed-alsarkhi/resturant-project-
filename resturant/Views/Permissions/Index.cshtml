@model IEnumerable<Permission>

@{
    ViewData["Title"] = "Permissions Page";
}

<div class="text-center">
    <h1 class="display-4 mb-4">The Permissions</h1>
</div>


<div class="row text-end mb-2">
    <div class="col-md-12">
        <button class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#createModal">
            Create Permission
        </button>
    </div>
</div>


<div class="container">

    <table class="table table-hover table-bordered border-dark">

        <thead>
            <tr class="table-primary  border-dark">
                <th>id</th>
                <th>name</th>
                
                <th>Edit & Delete</th>


            </tr>

        </thead>
        <tbody>
            @foreach (var Permission in Model)
            {
                <tr>
                    <td>@Permission.Id</td>
                    <td>@Permission.Name</td>
                    
                    <td>
                        <!-- Open Edit Modal -->
                        <button class="btn btn-warning"
                                data-bs-toggle="modal"
                                data-bs-target="#editModal-@Permission.Id">
                            Edit Permission
                        </button>


                        <!-- Open Edit Modal -->
                        <button class="btn btn-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal-@Permission.Id">
                            Delete Permission
                        </button>
                    </td>
                </tr>
            }



        </tbody>




    </table>

</div>


<!-- ================================================= -->
<!-- CREATE MODAL -->
<!-- ================================================= -->

<div class="modal fade"
     id="createModal"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <form asp-action="Create" method="post">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Create Permission
                    </h5>

                    <button type="button"
                            class="btn-close btn-danger"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="mb-3">

                        <label class="form-label">
                            Permission Name
                        </label>

                        <input name="Name"
                               class="form-control"
                               placeholder="Enter the Permission name" />

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Create
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- ================================================= -->
<!-- Edit & Delete MODAL -->
<!-- ================================================= -->
@foreach (var Permission in Model)
{
    <div class="modal fade"
         id="editModal-@Permission.Id"
         tabindex="-1">

        <div class="modal-dialog">

            <div class="modal-content">

                <form asp-action="Edit" method="post">

                    <!-- Important -->
                    <input type="hidden"
                           name="Id"
                           value="@Permission.Id" />


                    <div class="modal-header">

                        <h5 class="modal-title">
                            Edit Permission
                        </h5>

                        <button type="button"
                                class="btn-close btn-danger"
                                data-bs-dismiss="modal">
                        </button>

                    </div>


                    <div class="modal-body">

                        <div class="mb-3">

                            <label class="form-label">
                                Permission Name
                            </label>

                            <input type="text"
                                   name="Name"
                                   value="@Permission.Name"
                                   class="form-control" />

                        </div>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-warning">
                            Save changes
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <!-- ========================= -->
    <!-- DELETE MODAL -->
    <!-- ========================= -->

    <div class="modal fade"
         id="deleteModal-@Permission.Id"
         tabindex="-1">

        <div class="modal-dialog">

            <div class="modal-content">

                <form asp-action="Delete" method="post">

                    <input type="hidden"
                           name="id"
                           value="@Permission.Id" />


                    <div class="modal-header">

                        <h5 class="modal-title">
                            Delete Permission
                        </h5>

                        <button type="button"
                                class="btn-close btn-danger"
                                data-bs-dismiss="modal">
                        </button>

                    </div>


                    <div class="modal-body">

                        <p>
                            Are you sure you want to delete
                            <strong>@Permission.Name</strong>?
                        </p>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-danger">
                            Delete
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

}